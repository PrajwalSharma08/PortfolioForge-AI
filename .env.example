# PortfolioForge AI Environment Variables

# GitHub API (optional - for higher rate limits)
# Get a token from https://github.com/settings/tokens
GITHUB_TOKEN=

# AI Provider Configuration
# Options: "mock", "openai", "anthropic"
AI_PROVIDER=mock

# OpenAI (if using OpenAI provider)
OPENAI_API_KEY=

# Anthropic (if using Anthropic provider)
ANTHROPIC_API_KEY=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:6619
NEXT_PUBLIC_APP_NAME=PortfolioForge AI